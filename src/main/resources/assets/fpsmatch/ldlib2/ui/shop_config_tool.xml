<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch handheld shop-config tool overview — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2ShopConfigToolScreen.applyResponsiveLayout);
     this file owns structure, visuals and static text. Shop rows are Java-built buttons. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <style>
        /* 9px text on the Java-created shop rows */
        .compact-btn .__button_text__ {
            font-size: 9;
        }
    </style>
    <root id="fpsmatch.shop_config.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.shop_config.system" class="eyebrow" focusable="false"
               style="position: absolute; left: 18; right: 18; top: 2; height: 10"><lang key="gui.fpsm.shop_config.eyebrow"/></label>
        <label id="fpsmatch.shop_config.title" class="title" focusable="false"
               style="position: absolute; left: 18; right: 18; top: 13; height: 20"><lang key="gui.fpsm.shop_config.title"/></label>
        <element id="fpsmatch.shop_config.filters" class="panel" focusable="false">
            <label id="fpsmatch.shop_config.type.label" class="muted" focusable="false"
                   style="position: absolute; left: 8; top: 5; width: 140; height: 12"><lang key="gui.fpsm.shop_config.type"/></label>
            <label id="fpsmatch.shop_config.map.label" class="muted" focusable="false"
                   style="position: absolute; left: 50%; top: 5; width: 140; height: 12"><lang key="gui.fpsm.shop_config.map"/></label>
            <fpsm-selector id="fpsmatch.shop_config.type"/>
            <fpsm-selector id="fpsmatch.shop_config.map"/>
        </element>
        <virtual-scroller-view id="fpsmatch.shop_config.list" class="rhodes-scroller"
                               style="virtual-estimated-item-height: 34; virtual-overscan-pixels: 68"/>
        <label id="fpsmatch.shop_config.empty" class="muted" focusable="false"/>
        <label id="fpsmatch.shop_config.status" class="muted" focusable="false"/>
        <fpsm-button id="fpsmatch.shop_config.refresh" class="btn-secondary" text-key="gui.fpsm.shop_config.refresh"/>
        <fpsm-button id="fpsmatch.shop_config.close" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>

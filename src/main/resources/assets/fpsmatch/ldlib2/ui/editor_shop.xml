<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch shop editor work surface — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2ShopEditorUi.View.applyResponsiveLayout);
     this file owns structure, visuals and static text. Category tabs, slot cards and
     item slots are Java-built and styled with the shared rhodes classes. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <style>
        /* 9px text on the Java-created category buttons */
        .compact-btn .__button_text__ {
            font-size: 9;
        }
        /* selected slot card (class-toggled from Java) */
        .slot-card.__selected__ {
            background: group(rect(#FF3A3021, 0), border(1, #FFE6A23C));
        }
        /* disabled (empty) slot card */
        .slot-card.__disabled__ {
            background: rect(#FF202428, 0);
        }
    </style>
    <root id="fpsmatch.shop_editor.root" class="rhodes-root" style="width: 100%; height: 100%">
        <element id="fpsmatch.shop_editor.header" class="header-band" focusable="false">
            <label id="fpsmatch.shop_editor.header.system" class="eyebrow" focusable="false"><lang key="gui.fpsm.shop_editor.eyebrow"/></label>
            <label id="fpsmatch.shop_editor.header.title" class="title" focusable="false"><lang key="gui.fpsm.shop_editor.title"/></label>
            <label id="fpsmatch.shop_editor.subtitle" class="identity" focusable="false" style="font-size: 9"/>
            <label id="fpsmatch.shop_editor.header.mode" class="annotation accent-text" focusable="false"><lang key="gui.fpsm.shop_editor.edit_mode"/></label>
        </element>
        <element id="fpsmatch.shop_editor.categories" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.categories.title" class="section" focusable="false"><lang key="gui.fpsm.shop_editor.categories"/></label>
            <scroller-view id="fpsmatch.shop_editor.category_tabs" class="rhodes-scroller"/>
        </element>
        <element id="fpsmatch.shop_editor.slot_list" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.slot_list.title" class="section" focusable="false"><lang key="gui.fpsm.shop_editor.slots"/></label>
        </element>
        <element id="fpsmatch.shop_editor.properties" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.properties.title" class="section" focusable="false"><lang key="gui.fpsm.shop_editor.properties"/></label>
            <label id="fpsmatch.shop_editor.properties.name" class="body" focusable="false"/>
            <label id="fpsmatch.shop_editor.properties.type" class="muted" focusable="false"/>
            <label id="fpsmatch.shop_editor.properties.slot" class="muted" focusable="false"/>
            <label id="fpsmatch.shop_editor.properties.price" class="muted" focusable="false"/>
            <label id="fpsmatch.shop_editor.properties.quantity" class="muted" focusable="false"/>
            <label id="fpsmatch.shop_editor.properties.group" class="muted" focusable="false"/>
        </element>
        <element id="fpsmatch.shop_editor.actions" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.status" class="muted" focusable="false"/>
            <fpsm-button id="fpsmatch.shop_editor.edit_selected" class="btn-primary" text-key="gui.fpsm.shop_editor.edit_selected"/>
            <fpsm-button id="fpsmatch.shop_editor.close" class="btn-quiet" text-key="gui.back"/>
        </element>
    </root>
</ldlib2-ui>

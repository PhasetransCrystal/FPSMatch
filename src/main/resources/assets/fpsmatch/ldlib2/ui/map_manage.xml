<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch map management console — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2MapManageScreen.applyResponsiveLayout);
     this file owns structure, visuals and static text. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <root id="fpsmatch.map_manage.root" class="rhodes-root" style="width: 100%; height: 100%">
        <element id="fpsmatch.map_manage.tabs" class="lobby-tabs" focusable="false">
            <fpsm-button id="fpsmatch.map_manage.tab.details" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.details"><element class="tab-icon tab-icon-details" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.map_manage.tab.players" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.players"><element class="tab-icon tab-icon-players" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.map_manage.tab.settings" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.settings"><element class="tab-icon tab-icon-settings" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.map_manage.tab.more" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.more"><element class="tab-icon tab-icon-more" focusable="false"/></fpsm-button>
        </element>
        <label id="fpsmatch.map_manage.header" class="title" focusable="false"><lang key="gui.fpsm.team_manage.title"/></label>
        <label id="fpsmatch.map_manage.subtitle" class="identity" focusable="false"/>
        <scroller-view id="fpsmatch.map_manage.commands" class="rhodes-scroller" focusable="false">
            <label id="fpsmatch.map_manage.commands.title" class="section" focusable="false"><lang key="gui.fpsm.map_select.manage.match_actions"/></label>
            <fpsm-button id="fpsmatch.map_manage.start" class="btn-primary" text-key="gui.fpsm.map_select.debug.start"/>
            <fpsm-button id="fpsmatch.map_manage.reset" class="btn-secondary" text-key="gui.fpsm.map_select.debug.reset"/>
            <fpsm-button id="fpsmatch.map_manage.new_round" class="btn-secondary" text-key="gui.fpsm.map_select.debug.new_round"/>
            <fpsm-button id="fpsmatch.map_manage.cleanup" class="btn-secondary" text-key="gui.fpsm.map_select.debug.cleanup"/>
            <fpsm-button id="fpsmatch.map_manage.switch" class="btn-secondary" text-key="gui.fpsm.map_select.debug.switch"/>
        </scroller-view>
        <label id="fpsmatch.map_manage.permission" class="muted" focusable="false" style="text-wrap: wrap"/>
        <fpsm-button id="fpsmatch.map_manage.back" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui>
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <stylesheet location="fpsmatch:lss/team_lobby.lss"/>
    <root id="fpsmatch.team_manage.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.team_manage.header" class="title" focusable="false"/>
        <label id="fpsmatch.team_manage.subtitle" class="muted" focusable="false" style="text-wrap: hide"/>
        <element id="fpsmatch.team_manage.tabs" focusable="false">
            <fpsm-button id="fpsmatch.team_manage.tab.details" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.details"><element class="tab-icon tab-icon-details" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.team_manage.tab.players" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.players"><element class="tab-icon tab-icon-players" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.team_manage.tab.settings" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.settings"><element class="tab-icon tab-icon-settings" focusable="false"/></fpsm-button>
            <fpsm-button id="fpsmatch.team_manage.tab.more" class="lobby-tab" text-key="gui.fpsm.team_manage.tab.more"><element class="tab-icon tab-icon-more" focusable="false"/></fpsm-button>
        </element>
        <label id="fpsmatch.team_manage.ready_summary" class="ready-summary" focusable="false"/>
        <scroller-view id="fpsmatch.team_manage.details" class="rhodes-scroller lobby-details" focusable="false">
            <map-thumbnail id="fpsmatch.team_manage.details.preview" focusable="false"
                           style="width: 100%; height: 100; flex-shrink: 0"/>
            <label id="fpsmatch.team_manage.details.name" class="detail-name" focusable="false"/>
            <label id="fpsmatch.team_manage.details.mode" class="detail-fact" focusable="false"/>
            <label id="fpsmatch.team_manage.details.status" class="detail-fact" focusable="false"/>
            <label id="fpsmatch.team_manage.details.players" class="detail-fact" focusable="false"/>
            <label id="fpsmatch.team_manage.details.ready" class="detail-fact ready-summary" focusable="false"/>
            <label id="fpsmatch.team_manage.details.area" class="detail-fact detail-secondary" focusable="false"/>
            <label id="fpsmatch.team_manage.details.dimension" class="detail-fact detail-secondary" focusable="false"/>
            <label id="fpsmatch.team_manage.details.rules" class="detail-fact detail-secondary" focusable="false"/>
        </scroller-view>
        <virtual-scroller-view id="fpsmatch.team_manage.roster" class="rhodes-scroller"
                               style="virtual-estimated-item-height: 36; virtual-overscan-pixels: 108"/>
        <fpsm-button id="fpsmatch.team_manage.join" class="btn-primary" text-key="gui.fpsm.map_select.join"/>
        <fpsm-button id="fpsmatch.team_manage.leave" class="btn-secondary" text-key="gui.fpsm.map_select.leave" visible="false"/>
        <fpsm-button id="fpsmatch.team_manage.switch" class="btn-secondary" text-key="gui.fpsm.team_manage.context.switch"/>
        <fpsm-button id="fpsmatch.team_manage.ready" class="btn-primary" text-key="gui.fpsm.team_manage.ready.on"/>
        <fpsm-button id="fpsmatch.team_manage.back" class="btn-quiet" text-key="gui.back"/>
        <element id="fpsmatch.team_manage.menu_layer" visible="false"
                 style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 500">
            <element id="fpsmatch.team_manage.menu" class="context-menu">
                <label id="fpsmatch.team_manage.menu.player" class="body" focusable="false"
                       style="position: absolute; left: 10; right: 10; top: 8; height: 14; text-wrap: hide"/>
                <fpsm-button id="fpsmatch.team_manage.menu.move" class="menu-command"
                             text-key="gui.fpsm.team_manage.context.switch"
                             style="position: absolute; left: 5; right: 5; top: 29; height: 25">
                    <element class="command-icon command-icon-switch" focusable="false"/>
                </fpsm-button>
                <fpsm-button id="fpsmatch.team_manage.menu.kick" class="menu-command menu-danger"
                             text-key="gui.fpsm.team_manage.context.kick"
                             style="position: absolute; left: 5; right: 5; top: 59; height: 25">
                    <element class="command-icon command-icon-kick" focusable="false"/>
                </fpsm-button>
            </element>
        </element>
    </root>
</ldlib2-ui>

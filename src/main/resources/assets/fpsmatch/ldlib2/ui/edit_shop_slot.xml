<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch single-slot editor work surface — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2EditShopSlotUi.View.applyResponsiveLayout);
     this file owns structure, visuals and static text. The item slot and the player
     inventory grid are Java-built (menu-bound) and styled by the item-slot LSS rule. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <root id="fpsmatch.shop_editor.slot_editor" class="rhodes-root" style="width: 100%; height: 100%">
        <element id="fpsmatch.shop_editor.header.slot" class="header-band" focusable="false">
            <label id="fpsmatch.shop_editor.header.slot.system" class="eyebrow" focusable="false"><lang key="gui.fpsm.edit_shop_slot.eyebrow"/></label>
            <label id="fpsmatch.shop_editor.header.slot.title" class="title" focusable="false"><lang key="gui.fpsm.edit_shop_slot.title"/></label>
            <label id="fpsmatch.shop_editor.header.slot.identity" class="identity" focusable="false" style="font-size: 9"/>
        </element>
        <element id="fpsmatch.shop_editor.item.panel" class="panel" focusable="false">
            <fpsm-panel id="fpsmatch.shop_editor.item.card" class="panel-elevated">
                <label id="fpsmatch.shop_editor.item.caption" class="section" focusable="false"><lang key="gui.fpsm.shop_editor.item_label"/></label>
                <label id="fpsmatch.shop_editor.item.hint" class="muted" focusable="false"><lang key="gui.fpsm.shop_editor.item.replace"/></label>
            </fpsm-panel>
        </element>
        <element id="fpsmatch.shop_editor.slot_editor.form" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.ammo.label" class="muted" focusable="false"><lang key="gui.fpsm.dummy_ammo"/></label>
            <fpsm-textfield id="fpsmatch.shop_editor.ammo"/>
            <label id="fpsmatch.shop_editor.price.label" class="muted" focusable="false"><lang key="gui.fpsm.price"/></label>
            <fpsm-textfield id="fpsmatch.shop_editor.price.selected"/>
            <label id="fpsmatch.shop_editor.group.label" class="muted" focusable="false"><lang key="gui.fpsm.group"/></label>
            <fpsm-textfield id="fpsmatch.shop_editor.group.selected"/>
        </element>
        <element id="fpsmatch.shop_editor.slot_list.player" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.slot_list.player.caption" class="section" focusable="false"><lang key="container.inventory"/></label>
        </element>
        <element id="fpsmatch.shop_editor.actions.slot" class="panel" focusable="false">
            <label id="fpsmatch.shop_editor.status" class="accent-text" focusable="false"
                   style="font-size: 9"><lang key="gui.fpsm.shop_editor.state.editing"/></label>
            <fpsm-button id="fpsmatch.shop_editor.save" class="btn-primary" text-key="gui.fpsm.shop_editor.save_button"/>
            <fpsm-button id="fpsmatch.shop_editor.close.slot" class="btn-quiet" text-key="gui.back"/>
        </element>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch map invite picker — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2MapInviteScreen.applyResponsiveLayout);
     this file owns structure, visuals and static text. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <style>
        /* invite row internals — cloned per player from rows/invite_row.xml */
        .invite-row-name {
            position: absolute;
            left: 12; top: 10; right: 178; height: 14;
        }
        .invite-row-online {
            position: absolute;
            right: 92; top: 10; width: 76; height: 14;
        }
        .invite-row-action {
            position: absolute;
            right: 12; top: 10; width: 68; height: 14;
        }
        .compact .invite-row-name {
            left: 10; right: 88; top: 5; height: 15;
        }
        .compact .invite-row-online {
            left: 10; right: 88; top: 25; width: auto; height: 13;
        }
        .compact .invite-row-action {
            right: 10; top: 16; width: 68; height: 14;
        }
        .ok {
            text-color: #FF66B77B;
            text-shadow: false;
        }
    </style>
    <root id="fpsmatch.map_invite.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.map_invite.system" class="eyebrow" focusable="false"><lang key="gui.fpsm.map_select.title"/></label>
        <label id="fpsmatch.map_invite.header" class="title" focusable="false"><lang key="gui.fpsm.map_select.invite.title"/></label>
        <label id="fpsmatch.map_invite.subtitle" class="identity" focusable="false"/>
        <element id="fpsmatch.map_invite.panel" class="panel" focusable="false">
            <label id="fpsmatch.map_invite.empty" class="muted" focusable="false" style="text-wrap: wrap"><lang key="gui.fpsm.map_select.invite.empty"/></label>
            <virtual-scroller-view id="fpsmatch.map_invite.list" class="rhodes-scroller"
                                   style="virtual-estimated-item-height: 36; virtual-overscan-pixels: 48"/>
        </element>
        <fpsm-button id="fpsmatch.map_invite.back" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch map-room browser — competitive tactical HUD skin.
     Full-width room list with an inline toolbar. Room rows open the unified lobby;
     Shell geometry is applied from Java (responsive layout model); this file
     owns structure, visuals and static text. Refresh/close are icon buttons
     docked to the right edge of the header band. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <stylesheet location="fpsmatch:lss/map_select.lss"/>
    <root id="fpsmatch.map_selection.root" class="rhodes-root" style="width: 100%; height: 100%">

        <element id="fpsmatch.map_selection.header.band" class="header-band" focusable="false">
            <label id="fpsmatch.map_selection.header.system" class="eyebrow" focusable="false"
                   style="position: absolute; left: 10; right: 10; top: 3; height: 10"><lang key="gui.fpsm.map_select.eyebrow"/></label>
            <label id="fpsmatch.map_selection.header" class="title" focusable="false"
                   style="position: absolute; left: 10; right: 56; top: 14; height: 22"><lang key="gui.fpsm.map_select.title"/></label>
            <label id="fpsmatch.map_selection.header.scope" class="eyebrow" focusable="false"
                   style="position: absolute; right: 56; top: 17; width: 118; height: 12"><lang key="gui.fpsm.map_select.sync.ready"/></label>
            <fpsm-button id="fpsmatch.map_selection.browser_actions.refresh" class="icon-btn icon-refresh"
                         style="position: absolute; right: 32; top: 13; width: 18; height: 18"/>
            <fpsm-button id="fpsmatch.map_selection.browser_actions.close" class="icon-btn icon-close"
                         style="position: absolute; right: 10; top: 13; width: 18; height: 18"/>
        </element>

        <element id="fpsmatch.map_selection.toast" class="toast" focusable="false" visible="false">
            <label id="fpsmatch.map_selection.toast.text" class="body" focusable="false"
                   style="position: absolute; left: 10; right: 10; top: 3; bottom: 3"/>
        </element>

        <!-- list column: heading + inline toolbar + virtual list + empty state -->
        <label id="fpsmatch.map_selection.room_list.heading" class="section" focusable="false"><lang key="gui.fpsm.map_select.rooms.title"/></label>
        <fpsm-textfield id="fpsmatch.map_selection.search"/>
        <fpsm-selector id="fpsmatch.map_selection.filters.status"/>
        <fpsm-selector id="fpsmatch.map_selection.filters.mode"/>
        <virtual-scroller-view id="fpsmatch.map_selection.room_list" class="rhodes-scroller map-selection-scroller"
                               style="virtual-estimated-item-height: 60; virtual-overscan-pixels: 112"/>
        <label id="fpsmatch.map_selection.empty" class="muted" focusable="false" visible="false"
               style="text-wrap: wrap"><lang key="gui.fpsm.map_select.empty"/></label>

    </root>
</ldlib2-ui>

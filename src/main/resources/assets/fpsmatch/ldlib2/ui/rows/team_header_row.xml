<?xml version="1.0" encoding="UTF-8"?>
<!-- Team roster header row. Cloned per team via UITemplate by TeamRowBinder;
     ids are re-scoped per row from Java after cloning. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <root class="team-header-row" style="width: 100%; height: 33; margin-bottom: 3">
        <fpsm-button id="toggle" class="team-header-toggle"/>
        <element id="chevron" class="team-chevron-icon" focusable="false"/>
        <element id="segment" class="team-header-segment" focusable="false"/>
        <label id="label" class="team-header-label" focusable="false"/>
        <label id="count" class="team-header-count" focusable="false"/>
    </root>
</ldlib2-ui>

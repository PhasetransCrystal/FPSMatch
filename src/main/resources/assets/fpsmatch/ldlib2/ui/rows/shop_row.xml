<?xml version="1.0" encoding="UTF-8"?>
<!-- Row fragment for the shop picker list. Cloned per shop via UITemplate;
     ids are re-scoped per row from Java after cloning. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <root style="width: 100%; height: 40">
        <fpsm-panel id="row" class="panel-elevated" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0">
            <label id="name" class="body shop-row-name" focusable="false"/>
            <label id="team" class="muted ok shop-row-team" focusable="false"/>
            <fpsm-button id="edit" class="btn-secondary" text-key="gui.fpsm.map_shop.edit"/>
        </fpsm-panel>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Row fragment for the invite picker list. Cloned per player via UITemplate;
     ids are re-scoped per row from Java after cloning. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <root style="width: 100%; height: 34">
        <fpsm-button id="invite" class="room-row" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; height: auto">
            <label id="name" class="body invite-row-name" focusable="false"/>
            <label id="online" class="annotation ok invite-row-online" focusable="false"><lang key="gui.fpsm.map_select.online"/></label>
            <label id="action" class="annotation accent-text invite-row-action" focusable="false"><lang key="gui.fpsm.map_select.invite"/></label>
        </fpsm-button>
    </root>
</ldlib2-ui>

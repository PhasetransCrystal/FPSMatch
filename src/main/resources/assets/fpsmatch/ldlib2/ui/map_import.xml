<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <root id="fpsmatch.map_import.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.map_import.header" class="title" focusable="false"><lang key="gui.fpsm.map_import.title"/></label>
        <label id="fpsmatch.map_import.subtitle" class="identity" focusable="false"/>
        <element id="fpsmatch.map_import.panel" class="panel" focusable="false">
            <label id="fpsmatch.map_import.empty" class="muted" focusable="false"><lang key="gui.fpsm.map_import.empty"/></label>
            <virtual-scroller-view id="fpsmatch.map_import.list" class="rhodes-scroller" style="virtual-estimated-item-height: 35; virtual-overscan-pixels: 70"/>
        </element>
        <label id="fpsmatch.map_import.status" class="muted" focusable="false"/>
        <fpsm-toggle id="fpsmatch.map_import.settings"/>
        <fpsm-toggle id="fpsmatch.map_import.shop"/>
        <fpsm-toggle id="fpsmatch.map_import.kits"/>
        <fpsm-button id="fpsmatch.map_import.refresh" class="btn-secondary" text-key="gui.fpsm.shop_config.refresh"/>
        <fpsm-button id="fpsmatch.map_import.apply" class="btn-primary" text-key="gui.fpsm.map_import.action"/>
        <fpsm-button id="fpsmatch.map_import.back" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <root id="fpsmatch.map_regions.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.map_regions.header" class="title" focusable="false"><lang key="gui.fpsm.map_regions.title"/></label>
        <label id="fpsmatch.map_regions.subtitle" class="identity" focusable="false"/>
        <element id="fpsmatch.map_regions.list_panel" class="panel" focusable="false">
            <virtual-scroller-view id="fpsmatch.map_regions.list" class="rhodes-scroller"
                                   style="virtual-estimated-item-height: 31; virtual-overscan-pixels: 62"/>
        </element>
        <element id="fpsmatch.map_regions.editor" class="panel" focusable="false">
            <label id="fpsmatch.map_regions.selection" class="body" focusable="false"/>
            <label id="fpsmatch.map_regions.pos1_label" class="muted" focusable="false"><lang key="gui.fpsm.map_regions.pos1"/></label>
            <fpsm-textfield id="fpsmatch.map_regions.pos1"/>
            <fpsm-button id="fpsmatch.map_regions.use_pos1" class="btn-secondary" text-key="gui.fpsm.map_regions.use_position"/>
            <label id="fpsmatch.map_regions.pos2_label" class="muted" focusable="false"><lang key="gui.fpsm.map_regions.pos2"/></label>
            <fpsm-textfield id="fpsmatch.map_regions.pos2"/>
            <fpsm-button id="fpsmatch.map_regions.use_pos2" class="btn-secondary" text-key="gui.fpsm.map_regions.use_position"/>
        </element>
        <label id="fpsmatch.map_regions.status" class="muted" focusable="false"/>
        <fpsm-button id="fpsmatch.map_regions.add" class="btn-secondary" text-key="gui.fpsm.map_regions.add"/>
        <fpsm-button id="fpsmatch.map_regions.apply" class="btn-primary" text-key="gui.fpsm.map_regions.apply"/>
        <fpsm-button id="fpsmatch.map_regions.delete" class="btn-danger" text-key="gui.fpsm.map_regions.delete"/>
        <fpsm-button id="fpsmatch.map_regions.preview" class="btn-secondary" text-key="gui.fpsm.map_regions.preview"/>
        <fpsm-button id="fpsmatch.map_regions.back" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>

<?xml version="1.0" encoding="UTF-8"?>
<!-- FPSMatch shop picker — competitive tactical HUD skin.
     Shell geometry is applied from Java (Ldlib2MapShopScreen.applyResponsiveLayout);
     this file owns structure, visuals and static text. -->
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <stylesheet location="fpsmatch:lss/rhodes.lss"/>
    <style>
        /* shop row internals — cloned per shop from rows/shop_row.xml */
        .shop-row-name {
            position: absolute;
            left: 12; right: 214; top: 12; height: 14;
        }
        .shop-row-team {
            position: absolute;
            right: 106; top: 13; width: 96; height: 14;
        }
        .shop-row-action {
            position: absolute;
            right: 12; top: 12; width: 78; height: 14;
        }
        .compact .shop-row-name {
            left: 9; right: 76; top: 7; height: 14;
        }
        .compact .shop-row-team {
            left: 9; right: 76; top: 27; width: auto; height: 12;
        }
        .compact .shop-row-action {
            right: 9; top: 18; width: 60; height: 14;
        }
        .ok {
            text-color: #FF66B77B;
            text-shadow: false;
        }
        /* status line — text color is driven by Java state logic */
        .shop-status {
            font-size: 9;
            text-shadow: false;
        }
    </style>
    <root id="fpsmatch.map_shop.root" class="rhodes-root" style="width: 100%; height: 100%">
        <label id="fpsmatch.map_shop.header" class="title" focusable="false"><lang key="gui.fpsm.map_shop.title"/></label>
        <label id="fpsmatch.map_shop.subtitle" class="identity" focusable="false"/>
        <element id="fpsmatch.map_shop.panel" class="panel" focusable="false">
            <label id="fpsmatch.map_shop.empty" class="muted" focusable="false"><lang key="gui.fpsm.map_shop.unsupported"/></label>
            <virtual-scroller-view id="fpsmatch.map_shop.list" class="rhodes-scroller"
                                   style="virtual-estimated-item-height: 43; virtual-overscan-pixels: 48"/>
        </element>
        <label id="fpsmatch.map_shop.status" class="shop-status" focusable="false"><lang key="gui.fpsm.map_shop.selection.ready"/></label>
        <fpsm-button id="fpsmatch.map_shop.back" class="btn-quiet" text-key="gui.back"/>
    </root>
</ldlib2-ui>
